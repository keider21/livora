# Puerto del servidor HTTP + WebSocket
PORT=4000
NODE_ENV=development

# Base de datos (SQLite por defecto para desarrollo local)
DATABASE_URL="file:./dev.db"

# Firma de tokens JWT. Cambiar SIEMPRE en producción.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="30d"

# Origenes permitidos por CORS, separados por coma. "*" permite todos.
CORS_ORIGIN="*"

# Proveedor de streaming: mock | agora | livekit
STREAM_PROVIDER=mock
# Credenciales usadas solo por los proveedores reales
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
