// Esquema de datos de Livora Stream.
// SQLite en desarrollo: no soporta enums nativos, por eso los campos de tipo
// usan String con constantes definidas en src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  country      String?
  gender       String    @default("unspecified") // male | female | unspecified
  birthDate    DateTime?

  // Progresión y economía
  level    Int @default(1)
  xp       Int @default(0)
  coins    Int @default(0) // moneda que se compra y se gasta
  diamonds Int @default(0) // moneda que se recibe por regalos y se convierte

  isHost   Boolean @default(false)
  isBanned Boolean @default(false)

  /// Agencia a la que pertenece como anfitrión, si alguna lo captó.
  agencyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms         Room[]
  messages      Message[]
  giftsSent     GiftSend[]    @relation("GiftSender")
  giftsReceived GiftSend[]    @relation("GiftReceiver")
  transactions  Transaction[]
  following     Follow[]      @relation("Follower")
  followers     Follow[]      @relation("Following")
  seats         RoomSeat[]
  salaries      HostSalary[]
  agency        Agency?       @relation("AgencyHosts", fields: [agencyId], references: [id])
  ownedAgencies Agency[]      @relation("AgencyOwner")
  commissions   AgencyPayout[]
}

/// Agencia que capta y forma anfitriones, y cobra por lo que generan.
///
/// Es el motor de crecimiento de estas apps: quien recluta tiene un motivo para
/// hacerlo bien, porque cobra de lo que produzcan los suyos.
///
/// **La comisión sale del margen de la casa, no del bolsillo del anfitrión.** Un
/// anfitrión con agencia cobra exactamente lo mismo que uno sin ella; si no
/// fuera así, entrar en una agencia sería un castigo y nadie entraría.
model Agency {
  id      String @id @default(cuid())
  name    String
  /// Código que se comparte para que un anfitrión se una.
  code    String @unique
  ownerId String
  /// Parte de lo que ganan sus anfitriones que se lleva la agencia.
  rate    Float  @default(0.1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User           @relation("AgencyOwner", fields: [ownerId], references: [id])
  hosts   User[]         @relation("AgencyHosts")
  payouts AgencyPayout[]

  @@index([ownerId])
}

/// Cada comisión cobrada, con el anfitrión que la generó.
///
/// Se guarda fila a fila y no como un acumulado para que la agencia pueda ver de
/// dónde sale su dinero: sin el detalle, el número de arriba no se puede
/// discutir ni auditar.
model AgencyPayout {
  id       String @id @default(cuid())
  agencyId String
  hostId   String
  /// Diamantes que se llevó la agencia.
  diamonds Int
  /// Qué lo generó: `gift` o `salary`.
  source   String
  /// Diamantes que ganó el anfitrión y sobre los que se calculó.
  base     Int

  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])
  host   User   @relation(fields: [hostId], references: [id])

  @@index([agencyId, createdAt])
  @@index([hostId])
}

/// Salario diario ya pagado a un anfitrión.
///
/// El progreso del día no se guarda: se calcula de los regalos y las
/// transmisiones, que ya son la fuente de verdad. Aquí solo queda constancia de
/// lo pagado, y la clave única por día es lo que impide pagar dos veces si la
/// liquidación se lanza más de una vez.
model HostSalary {
  id     String @id @default(cuid())
  hostId String
  /// Día del calendario en la zona del corte, como YYYY-MM-DD.
  day    String

  level       Int
  /// Monedas de regalos de la suerte reunidas ese día.
  luckyCoins  Int
  liveSeconds Int
  /// Diamantes abonados.
  diamonds    Int

  paidAt DateTime @default(now())

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, day])
  @@index([day])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Room {
  id       String  @id @default(cuid())
  hostId   String
  title    String
  coverUrl String?
  category String  @default("chat") // chat | music | dance | game | talent
  status   String  @default("live") // live | ended

  // Identificador del canal en el proveedor de streaming (Agora/LiveKit/mock)
  channel String @unique

  viewerCount   Int @default(0)
  peakViewers   Int @default(0)
  totalDiamonds Int @default(0)
  totalLikes    Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  host     User       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  messages Message[]
  gifts    GiftSend[]
  seats    RoomSeat[]

  @@index([status, startedAt])
}

/// Invitado subido a la transmisión: aparece en la tira lateral, habla por
/// micrófono (nunca cámara) y puede recibir regalos como el anfitrión.
model RoomSeat {
  id       String  @id @default(cuid())
  roomId   String
  userId   String
  /// pending = ha pedido subir | active = está arriba
  status   String  @default("pending")
  /// 1..8, el hueco que ocupa en la tira. Nulo mientras está pendiente.
  position Int?
  micMuted Boolean @default(false)

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  leftAt      DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un usuario no puede tener dos solicitudes o asientos vivos en la misma
  /// sala; al bajarse se borra la fila en vez de dejarla histórica.
  @@unique([roomId, userId])
  @@index([roomId, status])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String?
  type      String   @default("text") // text | gift | join | system
  body      String
  createdAt DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model Gift {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  emoji      String
  priceCoins Int
  tier       String  @default("basic") // basic | rare | epic | legendary
  animation  String  @default("float") // float | burst | fullscreen
  isActive   Boolean @default(true)

  /// Probabilidad de premio, de 0 a 1. En 0 el regalo nunca devuelve nada.
  luckyChance      Float  @default(0)
  /// Multiplicadores posibles sobre lo gastado, separados por coma ("2,5,50").
  /// Se sortea uno al azar cuando toca premio.
  luckyMultipliers String @default("")

  /// Nivel de club de fans que hay que tener con el anfitrión para poder
  /// enviarlo. 0 significa que lo puede enviar cualquiera.
  minFanLevel Int @default(0)

  /// Nombre de la ilustración que dibuja la app en vez del emoji, si la tiene.
  /// Los archivos van empaquetados en `mobile/assets/gifts/`.
  image String?

  sends GiftSend[]
}

model GiftSend {
  id             String   @id @default(cuid())
  giftId         String
  roomId         String
  senderId       String
  receiverId     String
  quantity       Int      @default(1)
  coinsSpent     Int
  diamondsEarned Int
  /// Monedas devueltas al emisor por el premio, 0 si no tocó.
  coinsRewarded  Int      @default(0)
  createdAt      DateTime @default(now())

  gift     Gift @relation(fields: [giftId], references: [id])
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender   User @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([receiverId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  type         String // topup | gift_sent | gift_received | exchange
  currency     String // coins | diamonds
  amount       Int // positivo suma, negativo resta
  balanceAfter Int
  reference    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
